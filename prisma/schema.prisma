// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Identity & Access (docs/MODULES.md §1) ---

enum ClientType {
  mobile
  web
  ai_chat
  api
  mcp
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  baseCurrency String   @map("base_currency") @db.Char(3)
  locale       String
  createdAt    DateTime @default(now()) @map("created_at")

  clients    Client[]
  accounts   Account[]
  categories Category[]
  events     Event[]

  @@map("users")
}

model Client {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  type      ClientType
  name      String
  scopes    Json
  createdAt DateTime   @default(now()) @map("created_at")
  revokedAt DateTime?  @map("revoked_at")

  user     User      @relation(fields: [userId], references: [id])
  sessions Session[]
  events   Event[]

  @@map("clients")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")

  client Client @relation(fields: [clientId], references: [id])

  @@map("sessions")
}

// --- Accounts (docs/MODULES.md §2) ---

enum AccountType {
  cash
  bank
  card
  savings
  loan
  e_wallet
  investment
}

enum AccountGroup {
  personal
  freelance_business
}

model Account {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  name         String
  type         AccountType
  currency     String        @db.Char(3)
  accountGroup AccountGroup? @map("account_group")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")

  user          User            @relation(fields: [userId], references: [id])
  ledgerEntries LedgerEntry[]
  balance       AccountBalance?

  @@map("accounts")
}

// --- Categories (docs/MODULES.md §4) ---

enum CategoryKind {
  income
  expense
}

model Category {
  id       String       @id @default(uuid()) @db.Uuid
  userId   String?      @map("user_id") @db.Uuid
  parentId String?      @map("parent_id") @db.Uuid
  name     String
  kind     CategoryKind
  icon     String?

  user          User?         @relation(fields: [userId], references: [id])
  parent        Category?     @relation("CategoryToParent", fields: [parentId], references: [id])
  children      Category[]    @relation("CategoryToParent")
  ledgerEntries LedgerEntry[]

  @@map("categories")
}

// --- Currency & FX (docs/MODULES.md §5) ---

model FxRate {
  baseCurrency  String   @map("base_currency") @db.Char(3)
  quoteCurrency String   @map("quote_currency") @db.Char(3)
  rate          Decimal  @db.Decimal(18, 8)
  rateDate      DateTime @map("rate_date") @db.Date
  source        String?

  @@id([baseCurrency, quoteCurrency, rateDate])
  @@map("fx_rates")
}

// --- Ledger (docs/MODULES.md §3) ---

enum AggregateType {
  account
  ledger
  budget
  goal
}

enum EntryDirection {
  debit
  credit
}

model Event {
  id            String        @id @default(uuid()) @db.Uuid
  sequence      BigInt        @default(autoincrement())
  userId        String        @map("user_id") @db.Uuid
  clientId      String        @map("client_id") @db.Uuid
  aggregateType AggregateType @map("aggregate_type")
  aggregateId   String        @map("aggregate_id") @db.Uuid
  eventType     String        @map("event_type")
  payload       Json
  createdAt     DateTime      @default(now()) @map("created_at")

  user          User          @relation(fields: [userId], references: [id])
  client        Client        @relation(fields: [clientId], references: [id])
  ledgerEntries LedgerEntry[]

  @@map("events")
}

model LedgerEntry {
  id                 String         @id @default(uuid()) @db.Uuid
  eventId            String         @map("event_id") @db.Uuid
  transactionGroupId String         @map("transaction_group_id") @db.Uuid
  accountId          String         @map("account_id") @db.Uuid
  categoryId         String?        @map("category_id") @db.Uuid
  amount             Decimal        @db.Decimal(18, 4)
  direction          EntryDirection
  currency           String         @db.Char(3)
  fxRateToBase       Decimal        @map("fx_rate_to_base") @db.Decimal(18, 8)
  occurredAt         DateTime       @map("occurred_at")
  note               String?

  event    Event     @relation(fields: [eventId], references: [id])
  account  Account   @relation(fields: [accountId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  @@map("ledger_entries")
}

model AccountBalance {
  accountId String   @id @map("account_id") @db.Uuid
  balance   Decimal  @db.Decimal(18, 4)
  updatedAt DateTime @map("updated_at")

  account Account @relation(fields: [accountId], references: [id])

  @@map("account_balances")
}
